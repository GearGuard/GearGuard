{
  "name": "sandhavi/geargurd-framework",
  "description": "GearGurd PHP framework",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "authors": [
    {
      "name": "sandhavi",
      "email": "sandhavi@iee.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "GearGurd\\Framework\\": "framework/"
    }
  },
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "monolog/monolog": "^2.0",
    "vlucas/phpdotenv": "^5.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "symfony/var-dumper": "*"
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
